<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net462;net10.0</TargetFrameworks>
        <RootNamespace>NAPS2.Sdk.Worker</RootNamespace>
        <AssemblyName>NAPS2.Sdk.Worker.Win32</AssemblyName>

        <Title>NAPS2.Sdk.Worker.Win32</Title>
        <Product>NAPS2.Sdk.Worker.Win32</Product>
        <Description>Windows 32-bit (x86) worker process for NAPS2.Sdk</Description>
        <PackageTags>naps2</PackageTags>

    </PropertyGroup>

    <Import Project="..\NAPS2.Setup\targets\CommonTargets.targets" />
    <Import Project="..\NAPS2.Setup\targets\SdkPackageTargets.targets" />

    <PropertyGroup>
        <PackageVersion>1.3.1-evoscan.2</PackageVersion>
        <WorkerBuildTargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</WorkerBuildTargetFramework>
        <WorkerBuildTargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</WorkerBuildTargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="NAPS2.Sdk.Worker.Win32.targets" PackagePath="build/NAPS2.Sdk.Worker.Win32.targets" />
        <None Include="..\NAPS2.Sdk.Worker.Build\bin\$(Configuration)\$(WorkerBuildTargetFramework)\win-x86\publish\NAPS2.Worker.exe">
            <Link>lib/NAPS2.Worker.exe</Link>
            <Pack>true</Pack>
            <PackageCopyToOutput>true</PackageCopyToOutput>
            <PackagePath>contentFiles</PackagePath>
        </None>
    </ItemGroup>
</Project>
